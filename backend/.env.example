OPENROUTER_API_KEY=sk-or-v1-...
MODEL=openrouter:minimax/minimax-m2.7
# context window do modelo em tokens (usado pelo frontend para aviso de orçamento)
MODEL_CONTEXT_WINDOW=200000

# LangSmith tracing (opcional) — obter em https://smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=champion-ai-deepagents
