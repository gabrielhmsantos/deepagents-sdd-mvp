# Discriminador de provider LLM. Lido uma vez no startup do processo pelo
# agents.llm.factory. Valores aceitos:
#   - openrouter (default)  → usa OpenRouterAdapter (MODEL + apply_provider_profile)
#   - azure | azure_openai  → usa AzureOpenAIAdapter (env vars AZURE_OPENAI_*)
# Omitido = openrouter (backward-compat).
LLM_PROVIDER=openrouter

OPENROUTER_API_KEY=sk-or-v1-...
MODEL=openrouter:minimax/minimax-m2.7
MODEL_CONTEXT_WINDOW=200000
OPENROUTER_MAX_TOKENS=35000

# Daytona sandbox (brownfield mode); obter em https://app.daytona.io
# OBRIGATÓRIO para criar/executar sandboxes
DAYTONA_API_KEY=sk-...
DAYTONA_SERVER_URL=  # opcional: apenas para instâncias self-hosted
# Minutos de ociosidade antes do Daytona parar o sandbox (estado `stopped`).
# 0 desabilita auto-stop. Default 5 cobre testes locais; subir pra 45 em
# produção pra reduzir cold-starts. ensure_sandbox detecta `stopped` e dá
# client.start() automaticamente na próxima request.
DAYTONA_AUTO_STOP_INTERVAL_MIN=5
# TTL (segundos) do cache de estado do sandbox no manager. Evita HTTP roundtrip
# ao Daytona em /ensure repetidos dentro da janela. Default 60s; muito menor
# que auto_stop pra cache "running" ser confiável.
DAYTONA_STATE_CACHE_TTL_SECS=60

# Blob Storage para armazenamento de artefatos aprovados
# Vazio/ausente → NoopBlobAdapter (filesystem local em `.specs/{features,drafts}/`,
#                 sem credenciais; ideal pra dev local)
# Preenchido    → AzureBlobAdapter (produção; container `champion-ai`)
AZURE_STORAGE_CONNECTION_STRING=

# Cache TTL (segundos) do GET /api/github/repos. Reduz HTTP roundtrips ao
# GitHub em form opens frequentes. Default 300s (5min). Invalidação só por
# expiração — user que adiciona repo novo aguarda o TTL.
GITHUB_REPOS_CACHE_TTL_SECS=300

# LangSmith tracing (opcional); obter em https://smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=champion-ai-deepagents

# Azure OpenAI
AZURE_OPENAI_RESOURCE_NAME=REDAACTED
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_API_KEY=REDAACTED
AZURE_OPENAI_API_VERSION=2025-04-01-preview
