# Discriminador de provider LLM. Lido uma vez no startup do processo pelo
# agents.llm.factory. Valores aceitos:
#   - openrouter (default)  → usa OpenRouterAdapter (MODEL + apply_provider_profile)
#   - azure | azure_openai  → usa AzureOpenAIAdapter (env vars AZURE_OPENAI_*)
# Omitido = openrouter (backward-compat).
LLM_PROVIDER=openrouter

OPENROUTER_API_KEY=sk-or-v1-...
MODEL=openrouter:minimax/minimax-m2.7
MODEL_CONTEXT_WINDOW=200000
OPENROUTER_MAX_TOKENS=35000

# Daytona sandbox (brownfield mode); obter em https://app.daytona.io
# OBRIGATÓRIO para criar/executar sandboxes
DAYTONA_API_KEY=sk-...
DAYTONA_SERVER_URL=  # opcional: apenas para instâncias self-hosted

# Blob Storage para armazenamento de artefatos aprovados
# Ausente/vazio → NoopBlobAdapter (filesystem local, sem credenciais)
# Preenchido    → AzureBlobAdapter
AZURE_STORAGE_CONNECTION_STRING=

# LangSmith tracing (opcional); obter em https://smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=champion-ai-deepagents

# Azure OpenAI
AZURE_OPENAI_RESOURCE_NAME=REDAACTED
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_API_KEY=REDAACTED
AZURE_OPENAI_API_VERSION=2025-04-01-preview
